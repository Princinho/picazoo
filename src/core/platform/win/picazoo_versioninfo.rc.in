// Ressource de version Windows (VERSIONINFO) de nos exécutables, générée par CMake
// (src/core/CMakeLists.txt) dans <build>/src/core/generated/picazoo_versioninfo.rc.
// Le .rc qui l'inclut définit d'abord PICAZOO_FILE_DESCRIPTION et PICAZOO_ORIGINAL_FILENAME.
//
// SignPath vérifie le nom et la version du produit avant de signer
// (installer/signpath/*.xml, docs/signature.md) : ProductVersion et FileVersion valent
// toujours la version numérique a.b.c.d, la même que celle passée à SignPath.
// La version affichée (ex. dev-1a2b3c4) est dans « Comments ».
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PICAZOO_VERSION_COMMAS@
 PRODUCTVERSION @PICAZOO_VERSION_COMMAS@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "CompanyName", "Picazoo"
            VALUE "FileDescription", PICAZOO_FILE_DESCRIPTION
            VALUE "FileVersion", "@PICAZOO_VERSION_NUMERIC@"
            VALUE "InternalName", PICAZOO_ORIGINAL_FILENAME
            VALUE "LegalCopyright", "Les auteurs de Picazoo"
            VALUE "OriginalFilename", PICAZOO_ORIGINAL_FILENAME
            VALUE "ProductName", "Picazoo"
            VALUE "ProductVersion", "@PICAZOO_VERSION_NUMERIC@"
            VALUE "Comments", "Version @PICAZOO_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x40C, 1200
    END
END
